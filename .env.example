# =========================================================
# Authentication Microservice - Environment Variables
# Copy this file to `.env`, fill in real values, and keep it
# OUT of Git. Never commit real secrets.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS (bash):    cp .env.example .env
# =========================================================

# ---- Server -------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Database -----------------------------------------------
# Active Sequelize dialect: "mysql" (default/production) or "sqlite".
# Use "sqlite" only for local/test runs where a MySQL server is unavailable.
DB_DIALECT=mysql

# MySQL connection (used when DB_DIALECT=mysql).
# Format: mysql://user:password@host:port/database_name
# This must match MYSQL_ROOT_PASSWORD below when using docker-compose.
DATABASE_URL=mysql://root:postgres@127.0.0.1:3306/auth_microservice_db

# SQLite file path (used only when DB_DIALECT=sqlite). Optional; defaults to :memory:.
DB_STORAGE=./.tmp/auth.sqlite

# Password the bundled docker-compose MySQL container is created with.
# Keep it in sync with the password inside DATABASE_URL above.
MYSQL_ROOT_PASSWORD=postgres
MYSQL_DATABASE=auth_microservice_db

# ---- JWT (access token) -------------------------------------
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=auth-microservice
JWT_AUDIENCE=auth-api

# ---- Refresh tokens -----------------------------------------
REFRESH_TOKEN_TTL_DAYS=7

# ---- Password hashing ---------------------------------------
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----------------------------------------------------
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60
REFRESH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=900000

# ---- Tests ---------------------------------------------------
# Dialect used by the Jest suite: "sqlite" (default, no server needed)
# or "mysql" (runs against an isolated auth_microservice_test_db).
TEST_DB_DIALECT=sqlite
# Optional explicit SQLite file for tests. Omit to let each suite pick a temp file.
# TEST_DB_STORAGE=./.tmp/auth-test.sqlite

# ---- Admin bootstrap (for `npm run db:seed:admin`) ----------
# The ADMIN_PASSWORD here is a LOCAL DEV credential only.
# Never set a real production password in .env.example.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Before_Using_In_Prod_12345!
