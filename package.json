{
  "name": "auth-microservice",
  "version": "1.0.0",
  "description": "Role-Based User Authentication & JWT Microservice (Arrowstack Technologies internship - Task 1)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "db:migrate": "node scripts/db.mjs up",
    "db:migrate:undo": "node scripts/db.mjs down",
    "db:migrate:status": "node scripts/db.mjs status",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "lint": "eslint ."
  },
  "keywords": [
    "authentication",
    "jwt",
